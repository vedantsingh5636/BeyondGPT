# Required: Groq API key (never commit real secrets)
GROQ_API_KEY=your_groq_api_key_here

# Qdrant connection (use your Docker service URL or Qdrant Cloud endpoint in production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_documents
QDRANT_TIMEOUT_SECONDS=10.0

# Groq request timeout in seconds
GROQ_TIMEOUT_SECONDS=30.0

# Persistent upload directory (optional; defaults to backend/uploads)
UPLOAD_DIR=

# Security & request limits
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=100
MAX_DOCUMENT_CHUNKS=500
MAX_CHAT_MESSAGE_LENGTH=4000
RATE_LIMIT_PER_MINUTE=60

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Render Free (512 MB Linux) allocator tuning — set in Render Environment settings
MALLOC_ARENA_MAX=2
